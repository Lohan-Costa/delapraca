{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "De Lá Pra Cá",
  "version": "0.1.7",
  "identifier": "com.ciclomedia.delapraca",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "De Lá Pra Cá",
        "width": 380,
        "height": 330,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Ciclo Media",
    "shortDescription": "Serviço do De Lá Pra Cá",
    "longDescription": "Sobe e vigia o serviço local que atende o painel do De Lá Pra Cá dentro do Avid Media Composer."
  }
}
